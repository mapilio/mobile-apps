{
  "name": "mapilio-platform-react-native",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:debug": "react-native run-android",
    "android:release": "react-native run-android --variant=release",
    "ios": "expo run:ios",
    "eject": "expo eject",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage --coverageReporters=json-summary --coverageReporters=text",
    "lint": "eslint . --ext .js,.ts,.tsx --ignore-pattern node_modules --ignore-pattern android --ignore-pattern ios --ignore-pattern .expo",
    "postinstall": "node scripts/patch-onesignal-codegen.js"
  },
  "dependencies": {
    "@dogukany/react-native-walkthrough-tooltip": "^1.5.3",
