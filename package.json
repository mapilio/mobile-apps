    "expo-location": "~18.0.0",
    "expo-network": "~7.0.0",
    "expo-screen-orientation": "~8.0.0",
    "expo-sensors": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "expo-task-manager": "~12.0.0",
    "expo-updates": "~0.27.5",
    "expo-web-browser": "~14.0.0",
    "i18next": "^23.16.4",
    "jsog": "^1.0.7",
    "lottie-react-native": "7.1.0",
    "md5": "^2.3.0",
    "moment": "^2.30.1",
    "onesignal-expo-plugin": "^2.0.3",
