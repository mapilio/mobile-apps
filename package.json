    "expo-brightness": "~13.0.1",
    "expo-build-properties": "~0.13.0",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-image-manipulator": "~13.0.0",
