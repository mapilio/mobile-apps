{
  "expo": {
    "name": "Mapilio",
    "slug": "mapilio",
    "scheme": "mapilio",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/playstore.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash/mapilio_splash.png",
      "backgroundColor": "#213348",
      "resizeMode": "contain"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "facebookAppId": "254795350007625",
    "facebookDisplayName": "Mapilio",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.mapilio.app"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "WRITE_EXTERNAL_STORAGE",
        "WRITE_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/playstore.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "backgroundColor": "#213348",
        "resizeMode": "contain",
        "mdpi": "./assets/splash/mapilio_splash.png",
        "hdpi": "./assets/splash/mapilio_splash_x1.5.png",
        "xhdpi": "./assets/splash/mapilio_splash_x2.png",
        "xxhdpi": "./assets/splash/mapilio_splash_x3.png",
        "xxxhdpi": "./assets/splash/mapilio_splash_x4.png"
      },
      "package": "com.mapilio.app",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-mapbox-gl/maps",
      "expo-facebook",
      ["expo-location", { "isAndroidBackgroundLocationEnabled": false }]
    ]
  }
}
