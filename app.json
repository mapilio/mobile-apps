{
  "expo": {
    "name": "mapilio-platform-react-native",
    "slug": "mapilio-platform-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash/mapilio_splash.png",
      "backgroundColor": "#213348",
      "resizeMode": "contain"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "backgroundColor": "#213348",
        "resizeMode": "contain",
        "mdpi": "./assets/splash/mapilio_splash.png",
        "hdpi": "./assets/splash/mapilio_splash_x1.5.png",
        "xhdpi": "./assets/splash/mapilio_splash_x2.png",
        "xxhdpi": "./assets/splash/mapilio_splash_x3.png",
        "xxxhdpi": "./assets/splash/mapilio_splash_x4.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
