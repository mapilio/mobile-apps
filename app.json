{
  "expo": {
    "name": "Mapilio",
    "slug": "mapilio",
    "scheme": "mapilio",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/playstore.png",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "facebookAppId": "254795350007625",
    "facebookDisplayName": "Mapilio",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.mapilio.main",
      "buildNumber": "6"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "WRITE_EXTERNAL_STORAGE",
        "WRITE_SETTINGS"
      ],
      "icon": "./assets/playstore.png",
      "package": "com.mapilio.app",
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-facebook",
      [
        "@dogukany/react-native-vision-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME) needs access to the camera before you can capture photos."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox",
          "RNMapboxMapsDownloadToken": "***REMOVED***"
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
