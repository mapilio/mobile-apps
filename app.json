{
  "expo": {
    "name": "Mapilio",
    "slug": "mapilio",
    "scheme": "mapilio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/playstore.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash/mapilio_splash.png",
      "backgroundColor": "#213348",
      "resizeMode": "contain"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "facebookAppId": "254795350007625",
    "facebookDisplayName": "Mapilio",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.mapilio.main"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/playstore.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "backgroundColor": "#213348",
        "resizeMode": "contain",
        "mdpi": "./assets/splash/mapilio_splash.png",
        "hdpi": "./assets/splash/mapilio_splash_x1.5.png",
        "xhdpi": "./assets/splash/mapilio_splash_x2.png",
        "xxhdpi": "./assets/splash/mapilio_splash_x3.png",
        "xxxhdpi": "./assets/splash/mapilio_splash_x4.png"
      },
      "package": "com.mapilio.main",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["@react-native-mapbox-gl/maps", "expo-facebook"]
  }
}
