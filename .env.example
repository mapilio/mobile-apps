# ============================================================
# Mapilio Mobile App — Environment Variables
# Copy this file to .env.development (or .env.production) and fill in real values.
# NEVER commit real credentials. All keys below are placeholders.
# ============================================================

# --- API Endpoints ---
EXPO_PUBLIC_SERVICE_URL=https://end.mapilio.com
EXPO_PUBLIC_FORGOT_URL=https://mapilio.com/reset-password
EXPO_PUBLIC_IMAGE_API=https://cdn.mapilio.com/im
EXPO_PUBLIC_CDN_URL=https://cdn.mapilio.com
EXPO_PUBLIC_SEARCH_API=https://photon.komoot.io

# --- Map / Tiles (MapLibre) ---
# Tile URL templates use {z}, {x}, and {y} placeholders. Existing installations
# may keep using EXPO_PUBLIC_MAPBOX_ROAD_* and EXPO_PUBLIC_MAPBOX_POINT_*.
EXPO_PUBLIC_ROAD_TILE_URL=https://geo.mapilio.com/geoserver/gwc/service/wmts?REQUEST=GetTile&SERVICE=WMTS&VERSION=1.0.0&LAYER=mapilio:map_roads_line&STYLE=&TILEMATRIX=EPSG:900913:{z}&TILEMATRIXSET=EPSG:900913&FORMAT=application/vnd.mapbox-vector-tile&TILECOL={x}&TILEROW={y}
EXPO_PUBLIC_ROAD_TILE_ID=map_roads_line
EXPO_PUBLIC_POINT_TILE_URL=https://geo.mapilio.com/geoserver/gwc/service/wmts?REQUEST=GetTile&SERVICE=WMTS&VERSION=1.0.0&LAYER=mapilio:map_points&STYLE=&TILEMATRIX=EPSG:900913:{z}&TILEMATRIXSET=EPSG:900913&FORMAT=application/vnd.mapbox-vector-tile&TILECOL={x}&TILEROW={y}
EXPO_PUBLIC_POINT_TILE_ID=map_points

# --- OAuth / Auth ---
# Still required by the social login flows only (Google, Facebook, Apple, OSM),
# which send these to /oauth-api/*/authenticate on the legacy backend as query
# parameters. Email login and token refresh no longer use them: they go to
# /api/v1/mobile/auth/public-token, which authenticates the user's own
# credentials and needs no client secret.
#
# EXPO_PUBLIC values are embedded in the app bundle and are not confidential,
# so these cannot be treated as secrets while the social flows still send them.
# Removing that dependency is the remaining part of #84.
EXPO_PUBLIC_AUTH_CLIENT_ID=your_client_id
EXPO_PUBLIC_AUTH_CLIENT_SECRET=non_privileged_placeholder
EXPO_PUBLIC_APP_CONFIG_TOKEN=your_app_config_token

# --- Google Sign-In ---
EXPO_PUBLIC_GOOGLE_REQUEST_URL=https://www.googleapis.com/oauth2/v3/userinfo?access_token=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# --- Facebook ---
EXPO_PUBLIC_FACEBOOK_REQUEST_URL=https://graph.facebook.com/me?fields=id,name,email&access_token=
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token

# --- Google Sign-In ---
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your_ios_client_id

# --- EAS (Expo Application Services) ---
EAS_PROJECT_ID=your_eas_project_id

# --- OpenStreetMap OAuth ---
EXPO_PUBLIC_OSM_CLIENT_ID=your_osm_client_id
# Temporary legacy compatibility only. Do not place a confidential secret here.
EXPO_PUBLIC_OSM_CLIENT_SECRET=non_privileged_placeholder

# --- Monitoring (Sentry) ---
EXPO_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project_id

# --- Push Notifications (OneSignal) ---
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
